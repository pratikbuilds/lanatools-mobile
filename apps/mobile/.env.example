# Copy to .env (git-ignored). Values here are public: never put a secret in
# an EXPO_PUBLIC_ variable.

# The LanaTools production Privy app and this app's Android client.
EXPO_PUBLIC_PRIVY_APP_ID=cmtu5w0xo00xn0ckyrqhcsgoc
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# 1 plays back a mock agent, for building the UI before the Flue backend is
# set up. Without both Privy IDs it also signs in to a mock wallet.
EXPO_PUBLIC_MOCK_AGENT=1
