# Copy to .env (git-ignored). Values here are public: never put a secret in
# an EXPO_PUBLIC_ variable.

# The LanaTools production Privy app and this app's Android client.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# The Flue agent (apps/agent). In development it runs on this Mac; the
# emulator reaches it after `adb reverse tcp:8787 tcp:8787`.
EXPO_PUBLIC_AGENT_URL=http://localhost:8787

# 1 plays back a mock agent instead of the real one.
EXPO_PUBLIC_MOCK_AGENT=0

# 1 signs in to a mock wallet, until Privy is set up.
EXPO_PUBLIC_MOCK_WALLET=1
