# Copy to .dev.vars (git-ignored) for `npm run dev`. In production these are
# Worker secrets: `npx wrangler secret put ANTHROPIC_API_KEY`.
ANTHROPIC_API_KEY=

# Encrypts each user's LanaTools access token at rest in D1. Any 32 random
# bytes, base64: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
LANATOOLS_TOKEN_KEY=
